# ── Base de datos (Supabase PostgreSQL) ────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string → Transaction mode
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# URL directa para migraciones (sin pgbouncer)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase Storage (adjuntos) ─────────────────────────────────────────────────
# Dashboard → Project Settings → API (service_role es secreta: nunca en el frontend)
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_KEY="service_role_key"

# ── Correo (verificación de cuenta, recuperación de contraseña y avisos del backup) ──
# Si faltan, el sistema arranca pero los mails NO llegan (y la pantalla igual dice "enviado").
# SMTP_USER/SMTP_PASS: cuenta con la que el sistema inicia sesión en el servidor de correo
# (en Google Workspace suele ser una contraseña de aplicación). SMTP_FROM: remitente que ven los destinatarios.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="<cuenta-que-envia-los-mails>"
SMTP_PASS="<contraseña-de-esa-cuenta>"
SMTP_FROM=noreply@ies21.edu.ar

# ── Avisos del backup (deploy/backup-db.sh) ─────────────────────────────────────
# Mails que reciben el aviso si falla un backup y el resumen de los lunes. Varios separados por coma.
BACKUP_ALERT_EMAILS="<correo-de-avisos>"

# ── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET="cambiar_por_secreto_largo_y_aleatorio_minimo_32_chars"
JWT_EXPIRES_IN="8h"

# ── Servidor ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────────
# URL del frontend en desarrollo y producción
FRONTEND_URL="http://localhost:5173"
