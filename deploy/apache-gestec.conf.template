# Plantilla de VirtualHost para GESTEC en Apache.
# Antes de usar: reemplazar TU_DOMINIO_AQUI y /var/www/gestec por los valores reales del servidor.
# Requiere: a2enmod proxy proxy_http rewrite ssl

<VirtualHost *:80>
    ServerName TU_DOMINIO_AQUI

    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName TU_DOMINIO_AQUI

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/TU_DOMINIO_AQUI/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/TU_DOMINIO_AQUI/privkey.pem

    DocumentRoot /var/www/gestec/frontend/dist

    <Directory /var/www/gestec/frontend/dist>
        Options -Indexes
        AllowOverride All
        Require all granted
        # SPA fallback: rutas de React Router que no son un archivo real van a index.html
        FallbackResource /index.html
    </Directory>

    ProxyPreserveHost On
    ProxyPass /api http://localhost:3000/api
    ProxyPassReverse /api http://localhost:3000/api

    ErrorLog ${APACHE_LOG_DIR}/gestec-error.log
    CustomLog ${APACHE_LOG_DIR}/gestec-access.log combined
</VirtualHost>
