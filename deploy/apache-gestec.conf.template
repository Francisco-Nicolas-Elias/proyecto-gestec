# Plantilla de VirtualHost para GESTEC en Apache.
# Dominio: gestec.ies21.edu.ar. Antes de usar: reemplazar /var/www/gestec por la ruta real del servidor si difiere.
# Requiere: a2enmod proxy proxy_http rewrite ssl

<VirtualHost *:80>
    ServerName gestec.ies21.edu.ar

    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName gestec.ies21.edu.ar

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/gestec.ies21.edu.ar/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/gestec.ies21.edu.ar/privkey.pem

    DocumentRoot /var/www/gestec/frontend/dist

    <Directory /var/www/gestec/frontend/dist>
        Options -Indexes
        AllowOverride All
        Require all granted
        # SPA fallback: rutas de React Router que no son un archivo real van a index.html
        FallbackResource /index.html
    </Directory>

    ProxyPreserveHost On
    ProxyPass /api http://localhost:3000/api
    ProxyPassReverse /api http://localhost:3000/api

    ErrorLog ${APACHE_LOG_DIR}/gestec-error.log
    CustomLog ${APACHE_LOG_DIR}/gestec-access.log combined
</VirtualHost>
